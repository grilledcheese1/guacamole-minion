# Copy this file to .env.local and fill in real values.
#   cp .env.local.example .env.local

# SerpAPI — get your key at https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Turso (hosted libSQL). Leave BOTH blank to use a local apartments.db file
# instead (offline dev). To provision:
#   turso db show <db> --url     -> TURSO_DATABASE_URL  (libsql://<db>-<org>.turso.io)
#   turso db tokens create <db>  -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Google Maps API key for the frontend map + client-side address/ZIP geocoding.
# VITE_-prefixed so Vite exposes it to the browser bundle (it is NOT secret).
# Lock it down in Google Cloud console > APIs & Services > Credentials > this key:
#   Application restrictions > HTTP referrers  ->  add your Vercel domain(s)
#     e.g. https://your-app.vercel.app/*  and  http://localhost:*
#   API restrictions > "Maps JavaScript API" + "Geocoding API"
VITE_GOOGLE_MAPS_API_KEY=

# Shared-password gate for the DEPLOYED site (middleware.js). When set, visitors
# must enter this password before the app or /api/* responds — keeps bots from
# burning Maps + Turso quota. A correct submit stores a signed httpOnly cookie
# for 30 days. Leave BLANK to disable the gate (e.g. local dev).
SITE_PASSWORD=

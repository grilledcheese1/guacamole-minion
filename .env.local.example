# Copy this file to .env.local and fill in real values.
#   cp .env.local.example .env.local

# SerpAPI — get your key at https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Turso (hosted libSQL). Leave BOTH blank to use a local apartments.db file
# instead (offline dev). To provision:
#   turso db show <db> --url     -> TURSO_DATABASE_URL  (libsql://<db>-<org>.turso.io)
#   turso db tokens create <db>  -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
